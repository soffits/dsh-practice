{
  "name": "@soffits/dsh-practice",
  "version": "0.2.1",
  "description": "A language-practice page for DeepSeek Harness: today's plan, due review cards, a speaking recorder whose clips go to speech analysis, writing answers, session finish and progress, over the `practice` command line.",
  "type": "module",
  "license": "MIT",
  "author": "Sakina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soffits/dsh-practice.git"
  },
  "homepage": "https://github.com/soffits/dsh-practice#readme",
  "bugs": {
    "url": "https://github.com/soffits/dsh-practice/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "language-learning",
    "speaking",
    "recorder",
    "spaced-repetition"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "web",
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@soffits/dsh-ui-actions",
        "@soffits/dsh-ui-kit",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "check": "for f in index.js client.js src/*.js web/*.js test/*.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
